<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AzureFunctionsVersion>V4</AzureFunctionsVersion>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
		<PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="3.0.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.50.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
		
		
		
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="WorkerExtensions/**" />
		<EmbeddedResource Remove="WorkerExtensions/**" />
		<None Remove="WorkerExtensions/**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\AFH.Acs.Domain\AFH.Acs.Domain.csproj" />
		<ProjectReference Include="..\AFH.Acs.Contract\AFH.Acs.Contract.csproj" />
		<ProjectReference Include="..\AFH.Acs.Application\AFH.Acs.Application.csproj" />
		<ProjectReference Include="..\AFH.Acs.Infrastructure\AFH.Acs.Infrastructure.csproj" />
		<ProjectReference Include="..\..\..\..\sdk\afh-common-error\src\AFH.Common.Errors\AFH.Common.Errors.csproj" />
		<ProjectReference Include="..\..\..\..\sdk\afh-common-error\src\AFH.Common.Errors.AzureFunctions\AFH.Common.Errors.AzureFunctions.csproj" />
		<ProjectReference Include="..\..\..\..\sdk\afh-common-error\src\AFH.Common.Errors.Email\AFH.Common.Errors.Email.csproj" />
	</ItemGroup>
	<Target Name="RewriteGeneratedWorkerExtensionsProject"
	        AfterTargets="_FunctionsGenerateCommon"
	        BeforeTargets="_WorkerExtensionsRestore">
		<MakeDir Directories="$(ExtensionsCsProjDirectory)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)/WorkerExtensions/WorkerExtensions.template.csproj"
		      DestinationFiles="$(ExtensionsCsProj)"
		      OverwriteReadOnlyFiles="true" />
	</Target>
</Project>
