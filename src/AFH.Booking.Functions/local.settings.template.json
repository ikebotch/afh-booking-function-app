{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "BookingDb:ConnectionString": "Server=localhost;Database=AFH.Booking;Trusted_Connection=True;TrustServerCertificate=True",
    "Calendar:DefaultTimezone": "Europe/London",
    "Calendars:BaseUrl": "https://calendar-service.example",
    "Calendars:FunctionKey": "<calendar-function-key>",
    "Calendars:InternalToken": "<shared-internal-token>",
    "Calendars:NotificationsUrl": "https://booking-service.example/api/v1/calendar/notifications",
    "Calendars:ClientState": "<calendar-client-state>",
    "LocationService:BaseUrl": "https://location-service.example",
    "LocationService:FunctionKey": "<location-function-key>",
    "LocationService:InternalToken": "<shared-internal-token>",
    "Acs:Enabled": "true",
    "Acs:MeetingLinkServiceBaseUrl": "https://acs-service.example",
    "Acs:FunctionKey": "<acs-function-key>",
    "Acs:InternalToken": "<shared-internal-token>",
    "AdviserDirectory:BaseUrl": "https://location-service.example",
    "AdviserDirectory:InternalToken": "<shared-internal-token>",
    "Lifecycle:Reasons:Source": "Configuration",
    "Lifecycle:Reasons:CancellationCodes:0": "CLIENT_REQUEST",
    "Lifecycle:Reasons:CancellationCodes:1": "ADVISER_UNAVAILABLE",
    "Lifecycle:Reasons:RearrangementCodes:0": "CLIENT_RESCHEDULE",
    "Lifecycle:Reasons:RearrangementCodes:1": "CAPACITY_CHANGE",
    "Lifecycle:Notifications:Enabled": "true",
    "Lifecycle:Notifications:RecordFailures": "true",
    "Lifecycle:Escalation:Enabled": "false",
    "Lifecycle:Escalation:QueueName": "booking-lifecycle-escalations",
    "Lifecycle:Escalation:Owner": "booking-ops",
    "Lifecycle:Governance:PolicyName": "booking-lifecycle-default",
    "Lifecycle:Governance:ReviewOwner": "booking-ops",
    "Lifecycle:Governance:RetentionDays": "90",
    "OutlookGovernance:Enabled": "true",
    "OutlookGovernance:EscalationThreshold": "3",
    "OutlookGovernance:EscalationWindowHours": "24",
    "OutlookGovernance:AutoReconcileDeletedEvents": "false",
    "OutlookGovernance:AdviserNotificationsEnabled": "true",
    "OutlookGovernance:ManagerRecipients:0": "manager@example.com",
    "InternalApiAuth:Token": "<shared-internal-token>",
    "InternalApiAuth:AllowAnonymousInDevelopment": "true",
    "DomainUserAuth:Enabled": "true",
    "DomainUserAuth:TenantId": "<entra-tenant-id>",
    "DomainUserAuth:Authority": "https://login.microsoftonline.com/<entra-tenant-id>/v2.0",
    "DomainUserAuth:Audience": "api://<booking-api-app-id>",
    "DomainUserAuth:AllowedTenantIds:0": "<entra-tenant-id>",
    "DomainUserAuth:AllowedEmailDomains:0": "afh.co.uk",
    "DomainUserAuth:RoleMappings:0:Role": "Adviser",
    "DomainUserAuth:RoleMappings:0:AppRoles:0": "Adviser",
    "DomainUserAuth:RoleMappings:1:Role": "LeadTech",
    "DomainUserAuth:RoleMappings:1:AppRoles:0": "LeadTech",
    "DomainUserAuth:RoleMappings:2:Role": "Manager",
    "DomainUserAuth:RoleMappings:2:AppRoles:0": "Manager",
    "DomainUserAuth:RoleMappings:3:Role": "Operations",
    "DomainUserAuth:RoleMappings:3:AppRoles:0": "Operations",
    "DomainUserAuth:RoleMappings:4:Role": "Admin",
    "DomainUserAuth:RoleMappings:4:AppRoles:0": "Admin"
  }
}
